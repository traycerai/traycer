{
  "name": "scripts",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config scripts/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{projectRoot}/**/*.mjs",
        "{projectRoot}/**/*.js",
        "{projectRoot}/**/*.cjs",
        "{projectRoot}/**/*.sh",
        "{projectRoot}/**/*.json",
        "{projectRoot}/vitest.config.*",
        "{workspaceRoot}/.github/workflows/*.yml",
        "{workspaceRoot}/.github/workflows/*.yaml",
        "{workspaceRoot}/.pre-commit-config.yaml",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/clients/gui-app/scripts/lint-files.mjs",
        "sharedGlobals",
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/**/*vitest*config*.ts"
      ]
    }
  }
}
