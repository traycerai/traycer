{
  "name": "scripts",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config scripts/vitest.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{projectRoot}/**/*.mjs",
        "{projectRoot}/**/*.js",
        "{projectRoot}/**/*.cjs",
        "{projectRoot}/**/*.sh",
        "{projectRoot}/**/*.json",
        "{projectRoot}/vitest.config.*",
        "{workspaceRoot}/.github/workflows/test.yml",
        "sharedGlobals"
      ]
    }
  }
}
