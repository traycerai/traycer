  "redirects": [
    {
      "source": "/panels/chats",
      "destination": "/panels/agents"
    },
    {
      "source": "/account/organizations",
      "destination": "/account/teams"
    },
    {
      "source": "/legacy",
      "destination": "/extension"
    },
    {
      "source": "/changelog-extension",
      "destination": "/extension/changelog"
    },
    {
      "source": "/tasks/:slug*",
      "destination": "/extension/tasks/:slug*"
    },
    {
      "source": "/integrations/:slug*",
      "destination": "/extension/integrations/:slug*"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/traycerai/traycer"
      },
      {
        "label": "Contact Us",
        "href": "https://traycer.ai/contact-us"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://traycer.ai/settings"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
