      "author": "Traycer AI",
      "og:site_name": "Traycer AI Documentation",
      "og:url": "https://docs.traycer.ai",
      "og:type": "website",
      "og:title": "Traycer Docs",
      "og:description": "Learn Traycer: Tasks, agents, Chat and Terminal interfaces, artifacts, coding agents, models, storage, sync, and IDE extension workflows.",
      "twitter:site": "@TraycerAI",
      "twitter:creator": "@TraycerAI",
      "twitter:title": "Traycer Docs",
      "twitter:description": "Learn Traycer: Tasks, artifacts, coding agents, and models."
