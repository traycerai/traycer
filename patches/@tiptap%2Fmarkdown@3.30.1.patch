+function listItemBlockTokens(lexer: Lexer, src: string): Token[] {
+  const top = lexer.state.top
+  lexer.state.top = false
+  try {
+    return lexer.blockTokens(src, [])
+  } finally {
+    lexer.state.top = top
+  }
