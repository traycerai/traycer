+// The height the keyboard takes from the web view, in points: on a phone the
+// keyboard's own height, on an iPad the band of the web view the keyboard's
+// end frame covers. Measured afresh from every notification, because the
+// frame moves with rotation, with a Stage Manager window, and between a
+// hardware keyboard's shortcut bar and the software keyboard the person brings
+// up from it, so a height remembered from an earlier show describes a
+// different keyboard. Two iPad keyboards cover nothing the page should give
+// up: the shortcut bar shown with a hardware keyboard (under 100pt tall) and a
+// floating keyboard (narrower than half the web view), which the person drags
+// clear of what it hides.
+- (double)keyboardHeightForNotification:(NSNotification *)notification {
+  CGRect endFrame = [[notification.userInfo valueForKey:UIKeyboardFrameEndUserInfoKey] CGRectValue];
+  if (![self isIPad]) return endFrame.size.height;
+  UIWindow *window = self.webView.window;
+  if (window == nil) return 0;
+  CGRect keyboardInWindow = [window convertRect:endFrame fromCoordinateSpace:window.screen.coordinateSpace];
+  CGRect webViewInWindow = [self.webView convertRect:self.webView.bounds toView:window];
+  if (endFrame.size.height < 100 || keyboardInWindow.size.width < webViewInWindow.size.width / 2) return 0;
+  CGRect overlap = CGRectIntersection(keyboardInWindow, webViewInWindow);
+  return CGRectIsNull(overlap) ? 0 : overlap.size.height;
 }
 
