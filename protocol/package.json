{
  "name": "@traycer/protocol",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent/*": "./src/agent/*.ts",
    "./auth": "./src/auth/index.ts",
