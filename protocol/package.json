        "types": "./dist/src/host-transport/rtt-deadlines.d.ts",
        "import": "./dist/src/host-transport/rtt-deadlines.js"
      },
      "./host-transport/vantage": {
        "types": "./dist/src/host-transport/vantage.d.ts",
        "import": "./dist/src/host-transport/vantage.js"
      },
      "./framework": {
        "types": "./dist/src/framework/index.d.ts",
        "import": "./dist/src/framework/index.js"
      },
      "./framework/*": {
        "types": "./dist/src/framework/*.d.ts",
        "import": "./dist/src/framework/*.js"
      },
      "./notifications/*": {
        "types": "./dist/src/notifications/*.d.ts",
        "import": "./dist/src/notifications/*.js"
