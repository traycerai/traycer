      },
      "./utils/yjs-utils/*": {
        "types": "./dist/utils/yjs-utils/*.d.ts",
        "import": "./dist/utils/yjs-utils/*.js"
      },
      "./utils/text/*": {
        "types": "./dist/utils/text/*.d.ts",
        "import": "./dist/utils/text/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/patch-dist-esm-imports.cjs",
    "compile": "tsgo --noEmit --singleThreaded",
    "prepack": "bun run build",
    "test": "vitest run",
    "lint": "oxlint -c oxlint.config.ts --fix --deny-warnings ."
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.3",
    "tldts": "7.4.10",
