{
  "name": "@thanos/host",
  "version": "0.0.0-thanos",
  "description": "Thanos loopback host — Traycer-compatible /rpc without JWKS or CloudData",
  "type": "module",
  "private": true,
  "bin": {
    "thanos-host": "./src/main.ts"
  },
  "license": "MIT",
  "scripts": {
    "compile": "tsc --noEmit",
    "format": "bun x prettier --write .",
    "lint": "eslint . --cache --fix --max-warnings 0",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@traycer/protocol": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@traycer-clients/shared": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
