{
  "name": "traycer-clients-gui-app",
  "implicitDependencies": [
    "@traycer-clients/shared",
    "@traycer/protocol",
    "@traycer/html-source"
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"]
  },
  "targets": {
    "build": {
      "inputs": ["{projectRoot}/**/*", "^production", "sharedGlobals"]
    },
    "compile": {
      "inputs": ["{projectRoot}/**/*", "^production", "sharedGlobals"]
    },
    "lint": {
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/**/*.tsx",
        "{projectRoot}/**/*.mts",
        "{projectRoot}/**/*.cts",
        "{projectRoot}/**/*.js",
        "{projectRoot}/**/*.jsx",
        "{projectRoot}/**/*.mjs",
        "{projectRoot}/**/*.cjs",
        "{projectRoot}/.eslintrc*",
        "{projectRoot}/eslint.config.*",
        "{projectRoot}/.oxlintrc*",
        "{projectRoot}/oxlint.config.*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/**/*.css",
        "{projectRoot}/components.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/eslint/*.mjs",
        "^production",
        "sharedGlobals"
      ]
    },
    "format": {
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/**/*.tsx",
        "{projectRoot}/**/*.js",
        "{projectRoot}/**/*.jsx",
        "{projectRoot}/**/*.json",
        "sharedGlobals"
      ]
    }
  }
}
