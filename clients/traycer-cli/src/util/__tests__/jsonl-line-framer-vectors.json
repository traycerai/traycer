          ]
        ],
        "flush": null
      }
    },
    {
      "name": "exactly maxLineBytes is not over the bound",
      "maxLineBytes": 8,
      "chunksBase64": ["YWFhYWFhYWEK"],
      "expect": {
        "linesPerChunk": [["aaaaaaaa"]],
        "flush": null
      }
    },
    {
      "name": "one byte past the bound throws",
      "maxLineBytes": 8,
      "chunksBase64": ["YWFhYWFhYWFhCg=="],
      "expect": {
        "throwsAtChunk": 0
      }
    },
    {
      "name": "crossing the bound by accumulation throws",
      "maxLineBytes": 8,
      "chunksBase64": ["MTIzNDU=", "Njc4OTA="],
      "expect": {
        "throwsAtChunk": 1
      }
    },
    {
      "name": "an over-length line poisons the framer until discard()",
      "maxLineBytes": 8,
      "chunksBase64": ["MTIzNDU=", "Njc4OTA="],
      "expect": {
        "throwsAtChunk": 1,
        "afterDiscardBase64": "ZnJlc2gK",
        "afterDiscardLines": ["fresh"]
      }
    }
  ]
}
