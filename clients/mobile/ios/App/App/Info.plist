<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Traycer</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Not $(PRODUCT_NAME), which is the Xcode target "App": this is the
	     name the sign-in sheet's consent alert shows ("Traycer" Wants to Use
	     ...), where CFBundleDisplayName is not consulted. -->
	<key>CFBundleName</key>
	<string>Traycer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.traycer.app.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>traycer</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The iOS half of a direct download (IFileSaveHost.downloadFile), which
	     writes into the app's own Documents container. iOS has no shared
	     downloads folder an app may write to unaided, so these two keys are
	     what turn that container into a real destination: together they put
	     "Traycer" under On My iPhone in the Files app, where the written PNG
	     can be opened, moved and shared like any other file. Without them the
	     write still succeeds and the user can never reach it, which would make
	     the Download control a lie on this platform. Both are required - the
	     first surfaces the folder, the second lets other apps open its files
	     in place rather than only copy them out. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Traycer uses the camera to scan the sign-in QR code shown on your desktop.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Traycer saves exported images to your photo library when you choose Save Image.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Apple requires this of an app that does not support every iPad
	     orientation, which the portrait lock below now makes us. Read it as
	     "request compatibility mode", not as a guarantee of exclusive
	     full-screen presentation: it opts out of classic Split View and Slide
	     Over, but Stage Manager and iPadOS 26's windowing still present the
	     app scaled or windowed, and the key is deprecated for apps built
	     against the iOS 27 SDK (TN3192). So the app will meet arbitrary
	     widths eventually and must not depend on this to avoid them - it
	     does not: one layout, at every width, by construction. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- Portrait-only on every device, iPad included, and the two arrays are
	     deliberately identical. The app is a phone-layout product everywhere
	     (see gui-app/src/hooks/ui/use-mobile-viewport.ts), so landscape would
	     buy a wider phone shell rather than a different one - while costing
	     the WKWebView wedge that made the iPhone lock necessary in the first
	     place: rotating back leaves shrink-to-fit holding innerWidth at the
	     landscape value, and the app sits in a zoomed-out view until it is
	     relaunched. Android is locked to portrait to match, in
	     android/app/src/main/AndroidManifest.xml. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
